node_modules
dist
coverage
.catalystrc

# Python bytecode
__pycache__/
*.pyc

# Generated copies of /shared inside each function (scripts/copy-shared.sh)
functions/*/shared/

# IDE files
.vscode
.vscode/*
.idea/
*.swp
*.swo
